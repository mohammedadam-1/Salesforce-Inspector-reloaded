# ─────────────────────────────────────────────
# SFIR Backend — Environment Configuration
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# Environment
SFIR_ENVIRONMENT=development

# Database
SFIR_DATABASE_URL=postgresql+asyncpg://sfir:sfir@localhost:5432/sfir
SFIR_DATABASE_ECHO=false
SFIR_DATABASE_POOL_SIZE=10
SFIR_DATABASE_MAX_OVERFLOW=20

# Redis
SFIR_REDIS_URL=redis://localhost:6379/0

# Celery
SFIR_CELERY_BROKER_URL=redis://localhost:6379/1
SFIR_CELERY_RESULT_BACKEND=redis://localhost:6379/2
SFIR_CELERY_WORKER_CONCURRENCY=4
SFIR_CELERY_TASK_ALWAYS_EAGER=false
SFIR_CELERY_TASK_EAGER_PROPAGATES=false

# Auth (CHANGE IN PRODUCTION)
SFIR_JWT_SECRET_KEY=dev-jwt-secret-change-in-production
SFIR_JWT_ALGORITHM=HS256
SFIR_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SFIR_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SFIR_JWT_ISSUER=sfir-backend

# Encryption (CHANGE IN PRODUCTION)
SFIR_ENCRYPTION_KEY=dev-encryption-key-change-in-production-32bytes
SFIR_ENCRYPTION_ALGORITHM=AES-256-GCM

# Salesforce
SFIR_SALESFORCE_CLIENT_ID=
SFIR_SALESFORCE_CLIENT_SECRET=
SFIR_SALESFORCE_REDIRECT_URI=
SFIR_SALESFORCE_DEFAULT_API_VERSION=62.0
SFIR_SALESFORCE_MAX_RETRIES=3
SFIR_SALESFORCE_RETRY_DELAY=1.0
SFIR_SALESFORCE_RATE_LIMIT_PERCENTAGE=75

# AI / LLM
SFIR_LLM_DEFAULT_PROVIDER=openai
SFIR_OPENAI_API_KEY=
SFIR_OPENAI_MODEL=gpt-4o
SFIR_OPENAI_MAX_TOKENS=4096
SFIR_OPENAI_TIMEOUT_SECONDS=60
SFIR_ANTHROPIC_API_KEY=
SFIR_ANTHROPIC_MODEL=claude-sonnet-4-20250514
SFIR_ANTHROPIC_MAX_TOKENS=4096
SFIR_GROQ_API_KEY=
SFIR_GROQ_MODEL=llama-3.3-70b-versatile
SFIR_GROQ_MAX_TOKENS=4096
SFIR_OLLAMA_BASE_URL=http://localhost:11434
SFIR_OLLAMA_MODEL=llama3

# Observability
SFIR_OTLP_ENDPOINT=
SFIR_OTLP_SERVICE_NAME=sfir-backend
SFIR_LOG_LEVEL=INFO
SFIR_LOG_FORMAT=json
SFIR_METRICS_ENABLED=true
SFIR_TRACING_ENABLED=true

# Server
SFIR_HOST=0.0.0.0
SFIR_PORT=8000
SFIR_WORKERS=4
SFIR_MAX_REQUEST_SIZE=10485760

# CORS
SFIR_CORS_ORIGINS=["http://localhost:8000","chrome-extension://*"]

# Rate Limiting
SFIR_RATE_LIMIT_DEFAULT=1000
SFIR_RATE_LIMIT_WINDOW_SECONDS=60
SFIR_RATE_LIMIT_AI_PER_MINUTE=100
SFIR_RATE_LIMIT_DEPLOYMENT_PER_MINUTE=50
